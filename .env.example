# Server-only Supabase session-pooler URL for a persistent container. Do not commit the real password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_WITH_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
PG_SSL_ROOT_CERT=/app/certs/supabase-prod-ca-2021.crt

# Keep this below the connection limit of the selected Supabase plan.
PG_POOL_MAX=5
NODE_ENV=production
PORT=3000

# Final public hostname after its DNS A record points to Hetzner.
DOMAIN=politik-kompass-schweiz.info, www.politik-kompass-schweiz.info
