# Server-only Supabase transaction-pooler URL. Do not commit the real password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_WITH_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Keep this below the connection limit of the selected Supabase plan.
PG_POOL_MAX=5
NODE_ENV=production
PORT=3000

# Final public hostname after its DNS A record points to Hetzner.
DOMAIN=radar.example.com